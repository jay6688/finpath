# SEC requires automated clients to identify themselves.
# Use a project contact address. Do not commit a private email address.
# Example: FinPath/0.1 contact@your-project-domain.example
SEC_USER_AGENT=

# FinPath deliberately stays well below SEC's published 10 requests/second limit.
SEC_REQUESTS_PER_SECOND=2
SEC_COMPANY_FACTS_TTL_SECONDS=21600
SEC_TICKER_MAP_TTL_SECONDS=86400
SEC_STALE_IF_ERROR_SECONDS=604800
SEC_CACHE_PATH=apps/api/var/sec-cache.sqlite3

# Keep local interactive API docs available. Set this to false on a public host.
FINPATH_API_DOCS_ENABLED=true

# Optional when supplied to the Next.js process manually. The one-command
# startup uses this loopback value as the built-in web default.
FINPATH_API_BASE_URL=http://127.0.0.1:8000
